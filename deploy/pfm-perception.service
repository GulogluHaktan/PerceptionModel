# systemd USER unit (no root needed): copy to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now pfm-perception
#   loginctl enable-linger $USER     # start at boot without a login (needs the owner once)
[Unit]
Description=PerceptionModel gate perception (camera -> TensorRT -> UDP)
After=network.target

[Service]
WorkingDirectory=%h/pfm_vehicle
ExecStart=/usr/bin/python3 %h/pfm_vehicle/run.py --source csi --backend trt --udp 127.0.0.1:5600 --record %h/pfm_rec --record-every 30
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
