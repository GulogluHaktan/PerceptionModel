\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Closed-loop evaluation protocol in Isaac Lab simulation (no real-flight results). \textbf  {Top:} rendered frames pass through a fixed camera line (820$\times $616 sensor, 128$^\circ $ HFOV, 30\,Hz, 50\,ms delay, rolling shutter with tilt error, sensor corruptions, and an adaptive 384$\times $384 crop with derotation). A swappable gate detector then outputs 2D gate-corner observations. The detector is either the simulator-trained GateNet baseline or our frozen FastViT-SA24 core with CornerRefiner, CornerPeakHead, NearGateHead, duplicate suppression (IoU 0.2) and a 14\,px minimum-size filter. An EKF fuses these observations with a map prior of the gate layout, and a learned racing policy sends control commands back to the quadrotor. Only the detector changes between arms. \textbf  {Bottom left:} each seed generates a new random track with its own gate poses and sizes, decoys, obstacles, hall, quadrotor parameters and start pose. Four drones fly each seed for 3000 steps, and a flight succeeds only if all 22 gates are passed without a crash. \textbf  {Bottom right:} because loop noise is about $\pm $10--15 points for 32 flights, settings are chosen on validation seeds (31--38, 41--56) only. Results are reported on separate, never-used test seeds; the final tests (141--156, 161--176) use 64 flights per arm each.\relax }}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{6}{Closed-loop evaluation protocol in Isaac Lab simulation (no real-flight results). \textbf {Top:} rendered frames pass through a fixed camera line (820$\times $616 sensor, 128$^\circ $ HFOV, 30\,Hz, 50\,ms delay, rolling shutter with tilt error, sensor corruptions, and an adaptive 384$\times $384 crop with derotation). A swappable gate detector then outputs 2D gate-corner observations. The detector is either the simulator-trained GateNet baseline or our frozen FastViT-SA24 core with CornerRefiner, CornerPeakHead, NearGateHead, duplicate suppression (IoU 0.2) and a 14\,px minimum-size filter. An EKF fuses these observations with a map prior of the gate layout, and a learned racing policy sends control commands back to the quadrotor. Only the detector changes between arms. \textbf {Bottom left:} each seed generates a new random track with its own gate poses and sizes, decoys, obstacles, hall, quadrotor parameters and start pose. Four drones fly each seed for 3000 steps, and a flight succeeds only if all 22 gates are passed without a crash. \textbf {Bottom right:} because loop noise is about $\pm $10--15 points for 32 flights, settings are chosen on validation seeds (31--38, 41--56) only. Results are reported on separate, never-used test seeds; the final tests (141--156, 161--176) use 64 flights per arm each.\relax }{figure.caption.12}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][5][]6}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Final closed-loop success on never-used seeds (Isaac Lab simulation, 64 flights per arm per test). Ours is the frozen core with all modules and min14. W/L/T counts seeds where ours completes more/fewer/the same number of flights. Sign test on the combined result (ties excluded): $p\approx 0.14$.\relax }}{6}{table.caption.16}\protected@file@percent }
\newlabel{tab:main}{{1}{6}{Final closed-loop success on never-used seeds (Isaac Lab simulation, 64 flights per arm per test). Ours is the frozen core with all modules and min14. W/L/T counts seeds where ours completes more/fewer/the same number of flights. Sign test on the combined result (ties excluded): $p\approx 0.14$.\relax }{table.caption.16}{}}
\newlabel{tab:main@cref}{{[table][1][]1}{[1][5][]6}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces EKF next-gate position error (median/p90, metres) binned by true distance to the gate, on both clean tests.\relax }}{6}{table.caption.18}\protected@file@percent }
\newlabel{tab:ekf}{{2}{6}{EKF next-gate position error (median/p90, metres) binned by true distance to the gate, on both clean tests.\relax }{table.caption.18}{}}
\newlabel{tab:ekf@cref}{{[table][2][]2}{[1][6][]6}}
\@writefile{toc}{\contentsline {paragraph}{Estimator error.}{6}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Final clean tests in simulation (seeds 141--156 and 161--176, 64 flights per arm per test). \textbf  {(a)} Success rates with 95\% Wilson intervals and success counts. Ours reaches 87.5\% in both tests, against 81.2\% and 82.8\% for GateNet, and 87.5\% against 82.0\% over all 128 flights (+5.5 points). The intervals overlap, and the y-axis starts at 60\%. \textbf  {(b)} Per-seed outcomes (wins/losses/ties: 6/2/8, 6/3/7; 12/5/15 combined; hatched bars are combined). The sign test gives $p\approx 0.14$. The direction is consistent but not significant at $p<0.05$.\relax }}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:clean}{{3}{7}{Final clean tests in simulation (seeds 141--156 and 161--176, 64 flights per arm per test). \textbf {(a)} Success rates with 95\% Wilson intervals and success counts. Ours reaches 87.5\% in both tests, against 81.2\% and 82.8\% for GateNet, and 87.5\% against 82.0\% over all 128 flights (+5.5 points). The intervals overlap, and the y-axis starts at 60\%. \textbf {(b)} Per-seed outcomes (wins/losses/ties: 6/2/8, 6/3/7; 12/5/15 combined; hatched bars are combined). The sign test gives $p\approx 0.14$. The direction is consistent but not significant at $p<0.05$.\relax }{figure.caption.17}{}}
\newlabel{fig:clean@cref}{{[figure][3][]3}{[1][5][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces EKF next-gate position error by true distance, GateNet (grey) vs.\ ours (blue), on Test 1 (seeds 141--156, circles) and Test 2 (seeds 161--176, squares). Markers show medians; whiskers extend to p90. Up to 8\,m the medians nearly coincide (0.08--0.13\,m), but our p90 is lower. At 2--4\,m it is 0.27/0.26\,m against 0.35/0.41\,m, a reduction of about 23--37\%. For far gates (8+\,m) GateNet is better, with lower medians (0.21/0.20 vs.\ 0.24/0.24\,m) and shorter tails (p90 0.50/0.46 vs.\ 0.61/0.57\,m).\relax }}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:ekf}{{4}{7}{EKF next-gate position error by true distance, GateNet (grey) vs.\ ours (blue), on Test 1 (seeds 141--156, circles) and Test 2 (seeds 161--176, squares). Markers show medians; whiskers extend to p90. Up to 8\,m the medians nearly coincide (0.08--0.13\,m), but our p90 is lower. At 2--4\,m it is 0.27/0.26\,m against 0.35/0.41\,m, a reduction of about 23--37\%. For far gates (8+\,m) GateNet is better, with lower medians (0.21/0.20 vs.\ 0.24/0.24\,m) and shorter tails (p90 0.50/0.46 vs.\ 0.61/0.57\,m).\relax }{figure.caption.19}{}}
\newlabel{fig:ekf@cref}{{[figure][4][]4}{[1][6][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces General metrics of the frozen core (release v4). These values are identical with and without the plug-in modules, by construction (\cref  {eq:nonregression}).\relax }}{7}{table.caption.21}\protected@file@percent }
\newlabel{tab:general}{{3}{7}{General metrics of the frozen core (release v4). These values are identical with and without the plug-in modules, by construction (\cref {eq:nonregression}).\relax }{table.caption.21}{}}
