\@writefile{toc}{\contentsline {paragraph}{Step A: the frozen core alone is not enough.}{7}{section*.24}\protected@file@percent }
\citation{Xin2022DoCurrent}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Closed-loop success (\%) of the frozen-core detector at each development step (A--F), in Isaac Lab simulation only. Blue circles are clean, never-used seeds; filled orange diamonds are validation seeds 41--56. Hollow diamonds show val\_H on the same validation seeds and the min-size sweep (min8, min20) on seeds 41--48. Dashed grey segments show GateNet wherever it was evaluated on the same seeds. Grey bands mark loop noise of $\pm $10 and $\pm $15 points for 32 flights. Starting from 37.5\% against GateNet's 78.1\% (A), synthesised corner peaks (B), the CornerRefiner (C, no measurable loop gain) and the CornerPeakHead and NearGateHead (D) narrow the gap to about 10 points. Adding small near-gate detections without deduplication collapses success to 15.6\%. Global duplicate suppression (E) adds 14.0 points on validation and reaches 82.8\% against GateNet's 87.5\% on clean seeds 121--136. The 14\,px minimum-size filter (F) reaches 90.6\% on validation.\relax }}{8}{figure.caption.22}\protected@file@percent }
\newlabel{fig:path}{{5}{8}{Closed-loop success (\%) of the frozen-core detector at each development step (A--F), in Isaac Lab simulation only. Blue circles are clean, never-used seeds; filled orange diamonds are validation seeds 41--56. Hollow diamonds show val\_H on the same validation seeds and the min-size sweep (min8, min20) on seeds 41--48. Dashed grey segments show GateNet wherever it was evaluated on the same seeds. Grey bands mark loop noise of $\pm $10 and $\pm $15 points for 32 flights. Starting from 37.5\% against GateNet's 78.1\% (A), synthesised corner peaks (B), the CornerRefiner (C, no measurable loop gain) and the CornerPeakHead and NearGateHead (D) narrow the gap to about 10 points. Adding small near-gate detections without deduplication collapses success to 15.6\%. Global duplicate suppression (E) adds 14.0 points on validation and reaches 82.8\% against GateNet's 87.5\% on clean seeds 121--136. The 14\,px minimum-size filter (F) reaches 90.6\% on validation.\relax }{figure.caption.22}{}}
\newlabel{fig:path@cref}{{[figure][5][]5}{[1][7][]8}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Chronological development path (closed-loop success, \%). ``--'' indicates not measured on the same seeds or not reported.\relax }}{8}{table.caption.23}\protected@file@percent }
\newlabel{tab:path}{{4}{8}{Chronological development path (closed-loop success, \%). ``--'' indicates not measured on the same seeds or not reported.\relax }{table.caption.23}{}}
\newlabel{tab:path@cref}{{[table][4][]4}{[1][7][]8}}
\@writefile{toc}{\contentsline {paragraph}{Diagnosis: precision, not recall.}{8}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Median in-loop corner error (px, log scale) for detected frames only, GateNet (solid blue) vs.\ our frozen core at step B (hatched orange), in closed-loop simulation. For small gates (0--60\,px) the errors are 0.79 vs.\ 2.65\,px ($\times $3.4); for large gates ($>$250\,px), 9.4 vs.\ 26\,px ($\times $2.8). Inset: overall median 0.97 vs.\ 3.5\,px ($\times $3.6) and p90 3.3 vs.\ 16.5\,px ($\times $5.0). The green band marks the $\sim $1--2\,px precision required by the EKF. Both detectors find the gate in these frames, so the gap comes from precision, not recall.\relax }}{9}{figure.caption.25}\protected@file@percent }
\newlabel{fig:cornererr}{{6}{9}{Median in-loop corner error (px, log scale) for detected frames only, GateNet (solid blue) vs.\ our frozen core at step B (hatched orange), in closed-loop simulation. For small gates (0--60\,px) the errors are 0.79 vs.\ 2.65\,px ($\times $3.4); for large gates ($>$250\,px), 9.4 vs.\ 26\,px ($\times $2.8). Inset: overall median 0.97 vs.\ 3.5\,px ($\times $3.6) and p90 3.3 vs.\ 16.5\,px ($\times $5.0). The green band marks the $\sim $1--2\,px precision required by the EKF. Both detectors find the gate in these frames, so the gap comes from precision, not recall.\relax }{figure.caption.25}{}}
\newlabel{fig:cornererr@cref}{{[figure][6][]6}{[1][8][]9}}
\@writefile{toc}{\contentsline {paragraph}{Negative result: changing the core does not help.}{9}{section*.27}\protected@file@percent }
\@writefile{brf}{\backcite{Xin2022DoCurrent}{{9}{4.4}{section*.27}}}
\@writefile{toc}{\contentsline {paragraph}{Steps C and D: modules.}{9}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Negative result: duplicates collapse the loop.}{9}{section*.30}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Post-processing ablation in closed-loop simulation. \textbf  {(a)} Offline duplicate detections per frame: GateNet 0.018, val\_H 0.054, and 0.317 ($\approx $17.6$\times $ GateNet) after adding small near-gate detections without deduplication. In closed loop that configuration collapsed to 15.6\% success, although offline found rate and corner order looked acceptable. \textbf  {(b)} Validation success vs.\ minimum box side. min14 (star) reached 90.6\% on seeds 41--56 (64 flights); min8 and min20 reached 81.2\% and 78.1\% on the subset 41--48 (32 flights), so the comparison is not strictly matched. The dotted line marks val\_DS without a size filter (82.8\%, seeds 41--56). Shaded bands show $\pm $12 points.\relax }}{9}{figure.caption.29}\protected@file@percent }
\newlabel{fig:ablation}{{7}{9}{Post-processing ablation in closed-loop simulation. \textbf {(a)} Offline duplicate detections per frame: GateNet 0.018, val\_H 0.054, and 0.317 ($\approx $17.6$\times $ GateNet) after adding small near-gate detections without deduplication. In closed loop that configuration collapsed to 15.6\% success, although offline found rate and corner order looked acceptable. \textbf {(b)} Validation success vs.\ minimum box side. min14 (star) reached 90.6\% on seeds 41--56 (64 flights); min8 and min20 reached 81.2\% and 78.1\% on the subset 41--48 (32 flights), so the comparison is not strictly matched. The dotted line marks val\_DS without a size filter (82.8\%, seeds 41--56). Shaded bands show $\pm $12 points.\relax }{figure.caption.29}{}}
\newlabel{fig:ablation@cref}{{[figure][7][]7}{[1][9][]9}}
